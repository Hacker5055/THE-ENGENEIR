<?xml version="1.0" encoding="utf-8"?>
<!--
  The demo servers may be plain HTTP (local preview / staging). Production
  deployments should be HTTPS; the shell never downgrades a https URL.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
