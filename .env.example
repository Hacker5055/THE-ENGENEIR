# Optional public base URL for sitemap, robots, and OpenGraph metadata
NEXT_PUBLIC_SITE_URL=

# Optional path for persisting prototype auth state on disk
AM_STATE_FILE=

# Set to 1 only in local/dev environments to enable /api/dev/* helpers
ALLOW_DEV_SESSION=

# Firebase client configuration is stored in firebase-applet-config.json
FIREBASE_API_KEY=
