# ============================================================================
#  Al Mohandes — production configuration
#  Copy to `.env` (or set the same keys in your host dashboard) and restart.
#  Never commit the real file: `.env*` is git-ignored.
# ============================================================================

# --- Storage ---------------------------------------------------------------
# SQLite file. Relative paths resolve from the project root.
AM_DB_PATH=./.data/almohandes.db

# --- Mode ------------------------------------------------------------------
# 0 = production (no demo data, real accounts only)  ·  1 = training/demo data
# The first run of a production instance needs AM_ADMIN_* below.
AM_DEMO_MODE=0

# --- First-run administrator (created only when the database is empty) -----
AM_ADMIN_EMAIL=admin@your-domain.edu
# 12+ characters, upper + lower + digit + symbol. Change it after first login.
AM_ADMIN_PASSWORD=
AM_ADMIN_NAME_AR=مدير النظام
AM_ADMIN_NAME_EN=System administrator
# Force a password change at first sign-in (recommended: 1)
AM_ADMIN_FORCE_PASSWORD_CHANGE=1

# --- Institution identity (optional, shown across the UI and in e-mails) ----
AM_INSTITUTION_NAME_AR=أكاديمية المهندس للهندسة والتكنولوجيا
AM_INSTITUTION_NAME_EN=AL MOHANDES Academy of Engineering & Technology
AM_INSTITUTION_CODE=AMH
AM_INSTITUTION_CITY=الجيزة
AM_TIMEZONE=Africa/Cairo

# --- Public URL (used in e-mail links; behind a proxy this must be explicit) -
AM_BASE_URL=https://your-domain.edu

# --- Outbound mail (Gmail / Google Workspace example) -----------------------
# Google requires an *App Password* (2-Step Verification → App passwords).
AM_SMTP_HOST=smtp.gmail.com
AM_SMTP_PORT=465
AM_SMTP_USER=your-address@gmail.com
AM_SMTP_PASS=your-16-character-app-password
AM_MAIL_FROM=Al Mohandes <your-address@gmail.com>

# --- Development conveniences (never enable in real deployments) -----------
# ALLOW_DEV_SESSION=1   # mounts POST /api/dev/session (auto sign-in for tests)
